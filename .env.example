# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_secure_password
DB_NAME=caller_sheet3

# Google Gemini AI Configuration
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Security Configuration
APP_ENV=production
APP_DEBUG=false
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Application URLs
APP_URL=https://yourdomain.com
APP_NAME=CallFlow Pro

# Email Configuration (for notifications)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_email_password
SMTP_ENCRYPTION=tls

# File Upload Limits
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=xlsx,xls,jpg,jpeg,png,pdf

# Security Keys (generate random 32-character strings)
ENCRYPTION_KEY=generate_random_32_char_string_here
SESSION_ENCRYPTION_KEY=another_random_32_char_string